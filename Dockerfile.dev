# ---- Here's how to build this image locally:
#
# docker build -t registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-dev -f Dockerfile.dev .
#
# ---- run DC
# docker pull registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-dev
# docker run -itd --name gnirsdc-dev --privileged --network=host -v `pwd`:/work registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-dev bash -l



# Base image
FROM registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-base

# Maintainer label
LABEL maintainer="hawi.stecher@noirlab.edu"

ARG REGISTRY_TOKEN

# Update the system and install necessary packages
RUN dnf update -y && \
    dnf install -y git python3-pip && \
    dnf clean all

# Make Python 3.9 the default for python3
RUN alternatives --set python3 /usr/bin/python3.9

# Install Flask and other Python packages
RUN pip3 install flask flask-socketio

# Perform GitLab login using the token
RUN git config --global credential.helper store && \
    echo "https://oauth2:${REGISTRY_TOKEN}@gitlab.com" > ~/.git-credentials


# Install Python packages
# Install Python packages with specific versions
RUN python3.9 -m pip install --no-cache-dir \
    caproto \
    asyncinotify \
    astropy==5.1 \
    docopt \
    numpy==1.23.1 \
    pyepics \
    inotify-simple \
    scipy \
    pyserial \
    paramiko \
    markdown2  \
    matplotlib \
    psutil \
    requests

COPY ./pycadcar /pycadcar
WORKDIR /pycadcar
RUN python3.9 -m pip install .

COPY ./gnirsdc-lib /gnirsdc-lib
WORKDIR /gnirsdc-lib
RUN python3.9 -m pip install .

COPY ./gnirsdc /gnirsdc
WORKDIR /gnirsdc

# Extract the tar.gz file 
RUN tar -xzvf /gnirsdc/giapi-gluecc_rocky8.tar.gz -C /gnirsdc/

# Set the working directory to where giapi-gluecc will reside
WORKDIR /gnirsdc/giapi-glue-cc

# Set GIAPI_ROOT to the current directory
# and other environment variables relative to GIAPI_ROOT
ENV GIAPI_ROOT=/gnirsdc/giapi-glue-cc \
    BOOST_ROOT=/gnirsdc/giapi-glue-cc/external/boost \
    LD_LIBRARY_PATH=/usr/lib64:/usr/lib:/gnirsdc/giapi-glue-cc/external/apr/lib:/gnirsdc/giapi-glue-cc/external/apr-util/lib:/gnirsdc/giapi-glue-cc/external/activemq-cpp/lib:/gnirsdc/giapi-glue-cc/external/log4cxx/lib:/gnirsdc/giapi-glue-cc/external/cppunit/lib:/gnirsdc/giapi-glue-cc/external/curlpp/lib:/gnirsdc/giapi-glue-cc/external/curlpp/lib64:/gnirsdc/giapi-glue-cc/external/libcurl/lib:/gnirsdc/giapi-glue-cc/external/libcurl/lib64:/gnirsdc/giapi-glue-cc/install/lib

RUN echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH}"

WORKDIR /gnirsdc

# Download Socket.IO client library
RUN mkdir -p /gnirsdc/static/js && \
    curl -L https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js -o /gnirsdc/static/js/socket.io.js

# Start bash
CMD ["/bin/bash"]




