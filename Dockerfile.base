# Use Rocky Linux 8 as the base image
# NOTE:  this Dockerfile does not build on macos
FROM rockylinux/rockylinux:8

# Maintainer label
LABEL maintainer="hawi.stecher@noirlab.edu"

# -- To build the base evironment image
# 
#   git clone git@gitlab.com:nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager.git
#   git switch irdcioc
#   docker build -f Dockerfile.base -t registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-base .
#   docker push registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-base
#
# -- To build the runtime environment follow Dockerfile.linux_run 
#

# Run package updates and install dependencies in a single layer to reduce image size
RUN dnf -y update && \
    dnf -y install epel-release && \
    dnf -y config-manager --set-enabled powertools && \
    dnf -y module enable python39 && \
    dnf -y install \
        python3.9 \
        gcc-c++ \
        make \
        cmake \
        libstdc++ \
        libgcc \
        python39-devel \
        java-1.8.0-openjdk \
        json-c-devel \
        libuuid-devel \
        pybind11-devel \
        git && \
    dnf clean all

# Install cppyy
RUN STDCXX=11 MAKE_NPROCS=12 python3 -m pip install cppyy==2.4.0 --verbose --no-binary=cppyy-cling && \
    ln -s /usr/local/lib64/python3.9/site-packages/cppyy_backend/lib/libcppyy_backend.so /usr/local/lib/python3.9/site-packages/cppyy_backend/lib/libcppyy_backend.so

# Install Python packages
RUN python3.9 -m pip install caproto asyncinotify

# Create directory for readout data
RUN mkdir -p /readout_data/new



# Start bash
CMD ["/bin/bash"]

