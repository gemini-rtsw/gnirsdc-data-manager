FROM node:18-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    git \
    chromium \
    # Puppeteer/Chrome dependencies
    libglib2.0-0 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpangocairo-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create workspace for mermaid
WORKDIR /mermaid-setup

# Use a specific version of mermaid-cli known to work in containers
RUN npm init -y && \
    npm install @mermaid-js/mermaid-cli@10.0.2 puppeteer@19.7.0 && \
    npm link

# Configure Puppeteer to use system Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_ARGS="--no-sandbox --disable-setuid-sandbox"

# Create configuration for mmdc
RUN echo '#!/bin/bash\nnode /mermaid-setup/node_modules/.bin/mmdc "$@" --puppeteerConfigFile /mermaid-setup/puppeteer-config.json' > /usr/local/bin/mmdc && \
    chmod +x /usr/local/bin/mmdc && \
    echo '{"args": ["--no-sandbox", "--disable-setuid-sandbox"]}' > /mermaid-setup/puppeteer-config.json

# Create and activate a Python virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies in the virtual environment
RUN pip3 install markdown markdown-toc pymdown-extensions

# Set working directory
WORKDIR /docs

# Copy build script
COPY build-docs.sh /usr/local/bin/build-docs.sh
RUN chmod +x /usr/local/bin/build-docs.sh

# Default command
ENTRYPOINT ["build-docs.sh"] 