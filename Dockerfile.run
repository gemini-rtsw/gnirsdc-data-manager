# ---- Here's how to build this image locally:
#
# docker build -t registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run -f Dockerfile.run .
#
# ---- run DC
# docker pull registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run
# docker run -itd --name gnirsdc --privileged --network=host registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run


# Use a build argument to pass the PAT securely

# Base image
FROM registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-dev

# Maintainer label
LABEL maintainer="hawi.stecher@noirlab.edu"

# Start bash
CMD ["/gnirsdc/entrypoint.sh"]



