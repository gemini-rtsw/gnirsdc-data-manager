# ---- Here's how to build this image locally:
#
# docker build -t registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run -f Dockerfile.run .
#
# ---- run DC
# docker pull registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run
# docker run -itd --name gnirsdc --privileged --network=host registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run


# Use a build argument to pass the PAT securely

# Base image
FROM registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-base

# Maintainer label
LABEL maintainer="hawi.stecher@noirlab.edu"

RUN dnf install -y procps-ng git

RUN python3 -m pip install caproto asyncinotify astropy docopt numpy pyepics inotify-simple

COPY ./pycadcar /pycadcar
WORKDIR /pycadcar
RUN python3 -m pip install .

COPY ./gnirsdc-lib /gnirsdc-lib
WORKDIR /gnirsdc-lib
RUN python3 -m pip install .

COPY ./gnirsdc-tools /gnirsdc-tools
WORKDIR /gnirsdc-tools
RUN python3 -m pip install .

COPY ./gnirsdc /gnirsdc

# Set the working directory to where giapi-gluecc will reside
WORKDIR /gnirsdc/giapi-gluecc

# Set GIAPI_ROOT to the current directory
# and other environment variables relative to GIAPI_ROOT
ENV GIAPI_ROOT=/gnirsdc/giapi-gluecc \
    BOOST_ROOT=/gnirsdc/giapi-gluecc/external/boost \
    LD_LIBRARY_PATH=/gnirsdc/giapi-gluecc/external/apr/lib:/gnirsdc/giapi-gluecc/external/apr-util/lib:/gnirsdc/giapi-gluecc/external/activemq-cpp/lib:/gnirsdc/giapi-gluecc/external/log4cxx/lib:/gnirsdc/giapi-gluecc/external/cppunit/lib:/gnirsdc/giapi-gluecc/external/curlpp/lib:/gnirsdc/giapi-gluecc/external/curlpp/lib64:/gnirsdc/giapi-gluecc/external/libcurl/lib:/gnirsdc/giapi-gluecc/external/libcurl/lib64:/gnirsdc/giapi-gluecc/install/lib

RUN echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH}"

WORKDIR /gnirsdc

# Start bash
CMD ["/gnirsdc/entrypoint.sh"]



