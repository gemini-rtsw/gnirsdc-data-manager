#!/bin/bash
#
# Start the Detector Controller: the gmp and gnirsdc containers.
#
# Installed by the gnirsdc-data-manager RPM as /usr/local/bin/dc-start.sh. The
# System Manager runs it over SSH (as telops) for Start/Restart DC.
#
# THIS FILE IS A TEMPLATE: @IMAGE@ is replaced at RPM build time with the image
# this package release pins, the same one the gnirsdc-system-manager unit runs.
# Upgrading or downgrading the RPM therefore moves the DC to that release's
# image on the next start. GNIRSDC_IMAGE in /etc/sysconfig/gnirsdc overrides it,
# for testing a build that has not been released.

PINNED_IMAGE="@IMAGE@"
[ -r /etc/sysconfig/gnirsdc ] && . /etc/sysconfig/gnirsdc
IMAGE="${GNIRSDC_IMAGE:-$PINNED_IMAGE}"

echo "Starting Detector Controller Software"

start_container() {
    container_name=$1
    entrypoint=$2
    shift 2
    additional_args="$@"

    # Check if the container exists and remove it forcefully
    if docker ps -a --format '{{.Names}}' | grep -q "^${container_name}$"; then
        echo "Removing the '${container_name}' container..."
        docker rm -f ${container_name} > /dev/null 2>&1
        echo "The '${container_name}' container has been removed."
    else
        echo "The '${container_name}' container does not exist."
    fi

    # Run the container
    echo "Running the '${container_name}' container from ${IMAGE}..."
    output=$(docker run -d --network=host --privileged --name ${container_name} \
        -v /readout_data:/readout_data \
        -v /staging/perm:/staging/perm \
        -v /readout_data/conf:/gnirsdc/conf \
        -v /etc/localtime:/etc/localtime:ro \
        -v /etc/timezone:/etc/timezone:ro \
        ${entrypoint:+--entrypoint "$entrypoint"} \
        ${IMAGE} ${additional_args})

    # Check if the docker run command executed successfully
    if [ $? -eq 0 ]; then
        echo "The '${container_name}' container has been started successfully."
        echo "Container ID: $output"
        return 0
    else
        echo "Failed to start the '${container_name}' container."
        return 1
    fi
}

# Display help information
show_help() {
    echo "Usage: $0 [--help] [additional arguments for gnirsdc container]"
    echo
    echo "This script starts Docker containers for the Detector Controller Software"
    echo "using the image pinned by the installed gnirsdc-data-manager RPM:"
    echo "  ${IMAGE}"
    echo
    echo "The old containers will be deleted and replaced."
    echo
    echo "Options:"
    echo "  --help     Display this help message and exit."
    echo "  Additional arguments will be passed to the gnirsdc container."
}

# Check for help flag
if [[ "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# GMP and the DC run from the same image; GMP just has its own entrypoint.
start_container "gmp" /gnirsdc/entrypoint-gmp.sh
gmp_status=$?

# Start gnirsdc container with additional arguments (image entrypoint)
start_container "gnirsdc" "" "$@"
gnirsdc_status=$?

if [ $gmp_status -ne 0 ] || [ $gnirsdc_status -ne 0 ]; then
    echo "One or more containers failed to start."
    exit 1
fi
