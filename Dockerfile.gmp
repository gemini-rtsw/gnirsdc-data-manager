# Use Rocky Linux 9 as the base image
FROM rockylinux:9

RUN dnf -y update && dnf -y install procps

# Install Java 8
RUN dnf install -y java-1.8.0-openjdk

# Set the JAVA_HOME environment variable
ENV JAVA_HOME /usr/lib/jvm/jre

# Copy the gmp-server tar.gz file and the custom script into the container
COPY gmp-server-0.2.6-SNAPSHOT.tar.gz /tmp
COPY entrypoint-gmp.sh /usr/local/bin/

# Extract the tar.gz file into /usr/local/share
RUN tar -xzvf /tmp/gmp-server-0.2.6-SNAPSHOT.tar.gz -C /usr/local/share \
    && chmod +x /usr/local/bin/entrypoint-gmp.sh

# Set the working directory to the extraction directory
WORKDIR /usr/local/share/gmp-server-0.2.6-SNAPSHOT

COPY conf/gmp /usr/local/share/gmp-server-0.2.6-SNAPSHOT/conf/

# Command to start the gmp-server
CMD ["/usr/local/bin/entrypoint-gmp.sh"]

#run from the root dir of the gnirsdc-data-manager repo
#docker build -f Dockerfile.gmp -t registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gmp-server .
#docker run -d --network=host --name gmp -v /readout_data:/readout_data -v /staging/perm:/staging/perm registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gmp-server
