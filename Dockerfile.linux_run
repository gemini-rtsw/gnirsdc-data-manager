

# -- Instructions 
# ---- Repos
# git clone gnirsdc-data-manager
# git clone pycadcar
# git clone gnirsdc-tools
# git clone gnirsdc-lib
#
# Note: you will need two switch to the appropriate branches

# ---- build image
# docker build --no-cache -t registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run -f gnirsdc-data-manager/Dockerfile.linux_run .

# ---- run DC
# or pull registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run
# docker run -itd --name gnirsdc --privileged --network=host registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-run


# Use a build argument to pass the PAT securely
ARG PAT

# Base image
FROM registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-base

# Maintainer label
LABEL maintainer="hawi.stecher@noirlab.edu"

RUN dnf install -y procps-ng git


RUN git clone -b irdcioc            https://oauth2:$PAT@gitlab.com:nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager.git    /gnirsdc
RUN git clone -b main               https://oauth2:$PAT@gitlab.com:hstecher/pycadcar.git                                    /pycadcar
RUN git clone -b unstable/2022q1    https://oauth2:$PAT@gitlab.com:nsf-noirlab/gemini/rtsw/iocs/gnirsdc-tools.git           /gnirsdc-tools
RUN git clone -b pybind11           https://oauth2:$PAT@gitlab.com:nsf-noirlab/gemini/rtsw/iocs/gnirsdc-lib.git             /gnirsdc-lib

RUN python3 -m pip install caproto asyncinotify astropy docopt numpy pyepics


WORKDIR /pycadcar
RUN python3 -m pip install .

WORKDIR /gnirsdc-lib
RUN python3 -m pip install .

WORKDIR /gnirsdc-tools
RUN python3 -m pip install .

WORKDIR /gnirsdc



# Start bash
CMD ["/gnirsdc/entrypoint.sh"]



