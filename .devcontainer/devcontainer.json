{
    "name": "Your Project Name",
    "image": "registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-data-manager/gnirsdc-dev:latest",
    "overrideCommand": false,
    "runArgs": [
        "-it",
        "--network=host",
        "-v", "${env:HOME}/.ssh:/root/.ssh:ro",
        "-v", "${env:HOME}/irdc_data/readout_data:/readout_data:rw",
        "-v", "/etc/localtime:/etc/localtime:ro",
        "-v", "/etc/timezone:/etc/timezone:ro"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "mhutchie.git-graph",
                "gitlab.gitlab-workflow",
                "mhutchie.git-graph"
            ]
        }
    }
}
